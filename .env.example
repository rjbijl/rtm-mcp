# From https://www.rememberthemilk.com/services/api/keys.rtm
# Note: nothing reads this file; export these in your shell or pass them via the MCP config.
RTM_API_KEY=
RTM_SHARED_SECRET=
# The auth token comes from `npm run auth` and is stored in
# ~/.config/rtm-mcp/auth.json. Only set this if you prefer it in the environment:
# RTM_AUTH_TOKEN=
